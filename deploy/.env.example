# Copy to deploy/.env and fill in. Keep deploy/.env out of git (see .gitignore).

# Host directory that holds the code/targets you scan. It is mounted into the
# throwaway `dind` daemon at the SAME absolute path so Strix's host bind mounts
# resolve inside DinD. Put every scan target under here. Required.
STRIX_WORKSPACE=/absolute/path/to/your/scan/workspace

# --- Graphiti memory (LLM used for graph ingestion) ---
# Graphiti needs a model to extract entities/edges. Point it at your local LLM
# (plan item 4) or a provider. See the graphiti image docs for the exact vars;
# OPENAI_API_KEY / OPENAI_BASE_URL is the common path.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1   # e.g. a local Ollama
FALKORDB_PASSWORD=
FALKORDB_DATABASE=default_db
SEMAPHORE_LIMIT=10
